#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

if [ ! -f /etc/config/ctrld ] && [ -f /usr/share/ctrld/ctrld.config.default ]; then
	mkdir -p /etc/config
	cp /usr/share/ctrld/ctrld.config.default /etc/config/ctrld
	chmod 0600 /etc/config/ctrld
fi

if [ ! -f /etc/controld/ctrld.toml ] && [ -f /usr/share/ctrld/ctrld.toml.default ]; then
	mkdir -p /etc/controld
	cp /usr/share/ctrld/ctrld.toml.default /etc/controld/ctrld.toml
	chmod 0600 /etc/controld/ctrld.toml
fi

exit 0
