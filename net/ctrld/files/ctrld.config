config ctrld 'main'
	# Service is disabled by default on install (OpenWrt best practice); set to '1' to enable
	option enabled '0'

	# Control D Resolver ID (enables Control D API auto-configuration mode)
	# Leave empty when using a standalone local ctrld.toml configuration
	option cd_uid ''

	# Local TOML configuration file path
	option config_file '/etc/controld/ctrld.toml'

	# Directory for ctrld runtime state and generated configuration
	option homedir '/etc/controld'

	# Network interface for router/dnsmasq integration ('auto', 'br-lan', or empty to disable)
	option iface 'auto'

	# Log verbosity: 0 (default), 1 (-v), 2 (-vv)
	option verbose '0'

	# Bypass startup self-check DNS queries (0 or 1)
	option skip_self_checks '0'

	# OpenWrt 24.10+/25.12 compatibility (opt-in): set to '1' to automatically configure
	# dhcp.@dnsmasq[0].confdir='/tmp/dnsmasq.d' when unset and iface integration is active
	option fix_dnsmasq_confdir '0'

	# Optional space-separated extra CLI flags passed to `ctrld run`
	option extra_args ''
